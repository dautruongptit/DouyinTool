# ========================================
# Douyin Tool - bản web của Nimo Kids Tool (server Ubuntu)
# cp .env.example .env  rồi sửa giá trị
# ========================================

# === Định danh dự án (quy chuẩn [PP][SS]) ===
PROJECT_NAME=douyin-tool
PROJECT_CODE=86

# === Cổng ===
# 8600 là cổng người dùng mở trên trình duyệt (Cloudflare Tunnel trỏ vào đây).
WEB_PORT=8600

# === Thư mục dữ liệu trên server ===
# Chứa: media/ (video, thumbnail, video tổng), models/ (model Whisper ~3GB),
# browser_profile/ (đăng nhập Douyin), app/ (cài đặt, log).
# Ổ phải còn nhiều dung lượng vì video rất nặng.
DATA_PATH=/srv/douyin-tool/data

# === Thư mục lưu video (ổ riêng) ===
# Video tải về, thumbnail, video tổng. Gắn đè lên /data/media trong container.
# Quyền ghi: chown -R 1001:1001 thư mục này (UID của user trong container).
MEDIA_PATH=/media/mos/PhotoStorage

# === Phụ đề Whisper ===
# Model mặc định khi mở tab Phụ đề. ZBook không có CUDA nên chạy CPU int8.
# small = nhanh, medium = cân bằng (khuyên dùng), large-v3 = chính xác nhất nhưng rất chậm.
WHISPER_MODEL=medium

# === Giới hạn tài nguyên (tránh nghẽn các dịch vụ khác trên ZBook) ===
CPU_LIMIT=3.0
MEM_LIMIT=6g
